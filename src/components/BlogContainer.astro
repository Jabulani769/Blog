---
import Dir from "./Dir.astro";
import { getCollection } from "astro:content";
import PowerOnScreen from "./PowerOnScreen.astro";
import Terminal from "./terminal/Terminal.astro";
import BlogList from "./BlogList.astro";

const allPosts = await getCollection("blog", ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

const posts = allPosts.sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

// Serialize for both terminal commands AND BlogList
const serializedPosts = posts.map((post) => ({
  slug: post.slug,
  title: post.data.title,
  description: post.data.description || "No description.",
  pubDate: post.data.pubDate.toISOString().split("T")[0],
  image: post.data.image || null,
}));
---

<div
  class="w-[98%] md:w-[70%] m-auto relative"
  data-posts={JSON.stringify(serializedPosts)}
>
  <!-- Mode toggle -->
  <button
    id="mode-toggle"
    class="absolute top-1 right-1 px-4 py-1 bg-black text-cyan-400 font-mono text-sm rounded border border-cyan-600 hover:bg-cyan-900 transition z-50"
  >
    GUI Mode
  </button>

  <!-- Power on screen -->
  <PowerOnScreen />

  <!-- TERMINAL (visible by default) -->
  <div id="terminal-wrapper" class="block">
    <Terminal />
  </div>

  <!-- GUI MODE (hidden by default) -->
  <div id="gui-mode" class="hidden">
    <BlogList posts={serializedPosts} client:load />
  </div>
</div>

<script>
  // Global data
  const container = document.querySelector("[data-posts]");
  if (container instanceof HTMLElement && container.dataset.posts) {
    window.blogPosts = JSON.parse(container.dataset.posts);
  } else {
    window.blogPosts = [];
  }
  window.loadTime = Date.now();

  // Elements
  const toggleBtn = document.getElementById(
    "mode-toggle"
  ) as HTMLButtonElement | null;
  const terminalWrapper = document.getElementById("terminal-wrapper");
  const guiMode = document.getElementById("gui-mode");

  // Shared toggle function
  function switchToGUI() {
    if (!terminalWrapper || !guiMode || !toggleBtn) return;
    terminalWrapper.classList.add("hidden");
    guiMode.classList.remove("hidden");
    toggleBtn.textContent = "Terminal Mode";
  }

  function switchToTerminal() {
    if (!terminalWrapper || !guiMode || !toggleBtn) return;
    terminalWrapper.classList.remove("hidden");
    guiMode.classList.add("hidden");
    toggleBtn.textContent = "GUI Mode";
  }

  // Button click
  toggleBtn?.addEventListener("click", () => {
    const isTerminal = !terminalWrapper?.classList.contains("hidden");
    if (isTerminal) {
      switchToGUI();
    } else {
      switchToTerminal();
    }
  });

  // Listen for 'gui' command from terminal
  document.addEventListener("toggle-gui", switchToGUI);
</script>
