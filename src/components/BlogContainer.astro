---
import Dir from "./Dir.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("blog", ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

const posts = allPosts.sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const serializedPosts = posts.map((post) => ({
  slug: post.slug,
  title: post.data.title,
  description: post.data.description || "No description.",
  pubDate: post.data.pubDate.toISOString().split("T")[0],
  image: post.data.image || null,
}));
---

<div
  class="w-[98%] md:w-[70%] m-auto text-black relative"
  data-posts={JSON.stringify(serializedPosts)}
>
  <!-- mode toggle -->
  <button
    id="mode-toggle"
    class="absolute top-4 right-4 px-4 py-1 mx-1 my-1 bg-black text-cyan-400 font-mono text-sm rounded border border-cyan-600 hover:bg-cyan-900 transition z-10"
  >
    GUI Mode
  </button>

  <!-- terminal -->
  <div
    id="terminal-mode"
    class="font-mono text-cyan-400 bg-black rounded-md min-h-96"
  >
    <div id="output" class="mb-4 space-y-1 text-sm"></div>
    <div class="flex items-center">
      <Dir dir="jabublog@root:~#" />
      <input
        id="terminal-input"
        type="text"
        class="bg-transparent outline-none flex-1 ml-2 text-cyan-400 caret-cyan-400"
        autocomplete="off"
        autofocus
      />
      <span
        id="cursor"
        class="inline-block w-2 h-5 bg-cyan-400 ml-1 animate-blink"></span>
    </div>
  </div>

  <!-- gui -->
  <div id="gui-mode" class="hidden">
    <Dir dir="jabublog-[~]" class="mb-6" />
    <section
      class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-2 lg:grid-cols-3 gap-6"
    >
      {
        posts.map((post) => (
          <article class="rounded-lg shadow-md overflow-hidden flex sm:block bg-white">
            <div class="w-[40%] sm:w-full h-auto sm:h-64 bg-gray-800">
              {post.data.image ? (
                <img
                  src={post.data.image}
                  alt={post.data.title}
                  class="w-full h-full object-cover"
                />
              ) : (
                <div class="w-full h-full bg-gray-700 flex items-center justify-center text-gray-500 text-sm">
                  No image
                </div>
              )}
            </div>
            <div class="w-[60%] sm:w-full p-4 bg-amber-100 flex flex-col justify-between">
              <div>
                <h3 class="font-bold text-lg mb-2">{post.data.title}</h3>
                {post.data.description && (
                  <p class="text-sm text-gray-700 mb-3">
                    {post.data.description}
                  </p>
                )}
                <time class="text-xs text-gray-500">
                  {post.data.pubDate.toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  })}
                </time>
              </div>
              <a
                href={`/blog/${post.slug}`}
                class="text-cyan-600 hover:underline text-sm mt-1 inline-block"
              >
                cat {post.slug} →
              </a>
            </div>
          </article>
        ))
      }
    </section>
  </div>
</div>

<script>
  //  Types
  type Post = {
    slug: string;
    title: string;
    description?: string;
    pubDate: string;
    image?: string | null;
  };

  type CommandFn = (args?: string[]) => string;

  //  Posts
  const container = document.querySelector("[data-posts]");
  const posts: Post[] = container
    ? (JSON.parse((container as HTMLElement).dataset.posts || "[]") as Post[])
    : [];

  //  DOM
  const output = document.getElementById("output");
  const input = document.getElementById(
    "terminal-input"
  ) as HTMLInputElement | null;
  const terminalMode = document.getElementById("terminal-mode");
  const guiMode = document.getElementById("gui-mode");
  const toggleBtn = document.getElementById(
    "mode-toggle"
  ) as HTMLButtonElement | null;

  //  History
  const history: string[] = [];
  let historyIndex = -1;

  //  Post slugs ONLY (autocomplete source)
  const postSlugs = posts.map((p) => p.slug).sort();

  //  Commands
  const commands: Record<string, CommandFn> = {
    help: () => {
      const lines = [
        '<span class="text-cyan-300">Available commands:</span>',
        "",
        '  <br> &nbsp;&nbsp; - <span class="text-yellow-400">ls</span>             List all blog posts',
        '  <br> &nbsp;&nbsp; - <span class="text-yellow-400">cat</span> <slug>      Preview a post summary',
        '  <br> &nbsp;&nbsp; - <span class="text-yellow-400">open</span> <slug>     Open full post in GUI',
        '  <br> &nbsp;&nbsp; - <span class="text-yellow-400">clear</span>          Clear the terminal',
        '  <br> &nbsp;&nbsp; - <span class="text-yellow-400">gui</span>            Switch to GUI mode',
        '  <br> &nbsp;&nbsp; - <span class="text-yellow-400">help</span>           Show this help message',
        "",
        ' <br> <span class="text-green-400">Tip:</span> <br> &nbsp;&nbsp; • Tab for autocomplete <br> &nbsp;&nbsp;• ↑/↓ for history',
      ];
      return lines.join("\n");
    },

    ls: () =>
      posts.map((p) => `${p.slug.padEnd(35)} (${p.pubDate})`).join("\n"),

    cat: (args = []) => {
      if (!args[0]) return "Usage: cat <post-slug>";
      const post = posts.find((p) => p.slug === args[0]);
      if (!post)
        return `cat: ${args[0]}: No such file or directory\nHint: Use 'ls'`;

      let out = `
<span class="text-cyan-300 font-bold text-lg">${post.title}</span>
<span class="text-gray-500 text-sm">${post.pubDate} • jabublog@root</span>

`;
      if (post.image)
        out += `<span class="text-yellow-300">[Image: ${post.image}]</span>\n\n`;
      if (post.description) out += `${post.description}\n\n`;
      out += `
<span class="text-green-400">>>> Full post available in GUI</span>
<span class="text-yellow-300">Tip: open ${post.slug}</span>

<span class="text-gray-500">~ preview of ${args[0]} ~</span>
      `.trim();
      return out;
    },

    open: (args = []) => {
      if (!args[0]) return "Usage: open <post-slug>";
      const post = posts.find((p) => p.slug === args[0]);
      if (!post) return `open: No such file "${args[0]}"`;
      window.location.href = `/blog/${args[0]}`;
      return `Opening "${post.title}"...`;
    },

    clear: () => {
      if (output) output.innerHTML = "";
      return "";
    },

    gui: () => {
      toggleMode();
      return "Switching to GUI...";
    },
  };

  //  Helpers
  function appendLine(text: string, isCommand = false) {
    if (!output) return;
    const line = document.createElement("div");
    line.innerHTML = isCommand
      ? `<span class="text-gray-500">jabublog@root:~#</span> ${text}`
      : text;
    output.appendChild(line);
    output.scrollTop = output.scrollHeight;
  }

  //  AUTOCOMPLETE (POST SLUGS ONLY)
  function autocomplete() {
    if (!input) return;

    const value = input.value;
    const cursor = input.selectionStart ?? value.length;

    // IMPORTANT: do NOT trim
    const beforeCursor = value.slice(0, cursor);

    // Require at least ONE SPACE (command must be finished)
    if (!beforeCursor.includes(" ")) return;

    const parts = beforeCursor.split(" ");

    // Only autocomplete SECOND WORD (slug)
    if (parts.length !== 2) return;

    const slugPart = parts[1].toLowerCase();

    const matches = postSlugs.filter((slug) =>
      slug.toLowerCase().startsWith(slugPart)
    );

    if (!matches.length) return;

    if (matches.length === 1) {
      input.value = parts[0] + " " + matches[0] + " ";
    } else {
      appendLine(`<span class="text-gray-400">${matches.join("    ")}</span>`);
    }
  }

  function toggleMode() {
    if (!terminalMode || !guiMode || !toggleBtn || !input) return;
    const isGUI = terminalMode.classList.contains("hidden");
    terminalMode.classList.toggle("hidden", !isGUI);
    guiMode.classList.toggle("hidden", isGUI);
    toggleBtn.textContent = isGUI ? "GUI Mode" : "Terminal Mode";
    if (!isGUI) input.focus();
  }

  //  Boot
  async function bootAnimation() {
    if (!output || !input) return;
    output.innerHTML = "";
    input.style.display = "none";

    const bootLines = [
      '<span class="text-green-400">Linux 6.6.0-jabublog (jabu@root)</span>',
      "Mounting /blog... OK",
      `Loading posts... ${posts.length} found`,
      "",
      '--> Type <span class="text-yellow-400">help</span> • Tab for autocomplete • ↑/↓ for history',
    ];

    for (const line of bootLines) {
      appendLine(line);
      await new Promise((r) => setTimeout(r, 120));
    }

    input.style.display = "block";
    input.focus();
  }

  //  Events
  toggleBtn?.addEventListener("click", toggleMode);

  input?.addEventListener("keydown", (e: KeyboardEvent) => {
    if (e.key === "Enter") {
      const cmdLine = input.value.trim();
      if (cmdLine) {
        if (history.at(-1) !== cmdLine) history.push(cmdLine);
        historyIndex = history.length;
        appendLine(cmdLine, true);

        const [cmd, ...args] = cmdLine.split(" ");
        const handler = commands[cmd];
        handler
          ? appendLine(handler(args))
          : appendLine(
              `<span class="text-red-400">bash: ${cmd}: command not found</span>`
            );
      }
      input.value = "";
    } else if (e.key === "ArrowUp" && historyIndex > 0) {
      e.preventDefault();
      input.value = history[--historyIndex];
    } else if (e.key === "ArrowDown") {
      e.preventDefault();
      historyIndex < history.length - 1
        ? (input.value = history[++historyIndex])
        : ((historyIndex = history.length), (input.value = ""));
    } else if (e.key === "Tab") {
      e.preventDefault();
      autocomplete();
    }
  });

  terminalMode?.addEventListener("click", () => input?.focus());

  bootAnimation();
</script>
