---
interface Props {
  id: string;
  triggerText: string;
}

const { id, triggerText } = Astro.props;
---

<button
  data-modal-target={id}
  class="text-justify cursor-pointer hover:text-red-500 transition-colors font-bold"
>
  {triggerText}
</button>

<div
  id={id}
  style="display: none;"
  class="fixed inset-0 z-999 items-center justify-center bg-black/80 backdrop-blur-md px-4"
>
  <div
    class="bg-zinc-900 border-4 border-white p-6 max-w-lg w-full relative shadow-[15px_15px_0px_0px_rgba(255,255,255,1)]"
  >
    <button
      data-modal-close
      class="absolute -top-4 -right-4 bg-white text-black font-bold px-4 py-2 border-2 border-black hover:bg-red-500 hover:text-white transition-all"
    >
      CLOSE [X]
    </button>

    <div class="text-white overflow-hidden">
      <slot />
    </div>
  </div>
</div>

<script>
  // This function runs every time the page loads/transitions
  const setupModals = () => {
    const triggers = document.querySelectorAll("[data-modal-target]");

    triggers.forEach((trigger) => {
      trigger.addEventListener("click", (e) => {
        e.preventDefault();
        const modalId = trigger.getAttribute("data-modal-target");
        const modal = document.getElementById(modalId!);
        if (modal) {
          // We use inline styles to override any Tailwind conflicts
          modal.style.display = "flex";
          document.body.style.overflow = "hidden";
        }
      });
    });

    const closeButtons = document.querySelectorAll("[data-modal-close]");
    closeButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const modal = button.closest(".fixed") as HTMLElement;
        if (modal) {
          modal.style.display = "none";
          document.body.style.overflow = "auto";
        }
      });
    });

    // Close on clicking the dark overlay outside the box
    window.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).classList.contains("fixed")) {
        (e.target as HTMLElement).style.display = "none";
        document.body.style.overflow = "auto";
      }
    });
  };

  // Run on initial load
  setupModals();
  // If you use Astro View Transitions, run it on every swap
  document.addEventListener("astro:after-swap", setupModals);
</script>
